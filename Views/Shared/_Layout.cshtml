<!DOCTYPE html>
<html lang="kk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ViewModelValidation</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">ViewModelValidation</a>
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Басты бет</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Product" asp-action="Index">Тауарлар</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Product" asp-action="Create">Жаңа тауар</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Тіркелу</a></li>
            </ul>
        </div>
    </nav>

    <main class="container pb-5">
        @RenderBody()
    </main>

    <footer class="text-center text-muted border-top py-3">
        ИСК-241 · Ақжол Биболат · 4-апта: ViewModels және Валидация
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
