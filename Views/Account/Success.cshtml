@model RegisterSuccessViewModel
@{
    ViewData["Title"] = "Тіркелу сәтті өтті";
}

<div class="alert alert-success">
    <h4 class="alert-heading">Қош келдіңіз, @Model.FullName!</h4>
    <p class="mb-0">Профиліңіз сәтті тіркелді.</p>
</div>

<dl class="row">
    <dt class="col-sm-3">Логин</dt>
    <dd class="col-sm-9">@Model.UserName</dd>
    <dt class="col-sm-3">E-mail</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Телефон</dt>
    <dd class="col-sm-9">@Model.Phone</dd>
    <dt class="col-sm-3">Туған күні</dt>
    <dd class="col-sm-9">@Model.BirthDate.ToString("dd.MM.yyyy")</dd>
    <dt class="col-sm-3">Курс</dt>
    <dd class="col-sm-9">@Model.Course</dd>
    <dt class="col-sm-3">Тіркелген уақыты</dt>
    <dd class="col-sm-9">@Model.RegisteredAt.ToString("dd.MM.yyyy HH:mm")</dd>
</dl>

<a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Басты бетке</a>
